import java.util.*;

public class Main {

    static void reverseArray(int[] arr, int index) {
        if (index < 0) {
            return;
        }

        System.out.print(arr[index] + " ");
        reverseArray(arr, index - 1);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();
        int[] arr = new int[N];

        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

        reverseArray(arr, N - 1);
    }
}
