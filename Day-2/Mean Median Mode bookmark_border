import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n];

        long sum = 0;

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
            sum += a[i];
        }

        // Mean
        double mean = (double) sum / n;

        // Median
        double median;
        if (n % 2 == 1) {
            median = a[n / 2];
        } else {
            median = (a[n / 2 - 1] + a[n / 2]) / 2.0;
        }

        // Mode
        int mode = a[0];
        int maxCount = 1;
        int count = 1;

        for (int i = 1; i < n; i++) {
            if (a[i] == a[i - 1]) {
                count++;
            } else {
                count = 1;
            }

            // Do not replace when count == maxCount
            // so the first mode from the left is retained
            if (count > maxCount) {
                maxCount = count;
                mode = a[i];
            }
        }

        System.out.printf("%.2f %.2f %d", mean, median, mode);
    }
}
